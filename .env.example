# Server
NODE_ENV=development
PORT=8999
APP_BASE_URL=http://localhost:8999
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# JWT / session
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=nexus_auth_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Token encryption for stored provider tokens (32+ chars)
TOKEN_ENCRYPT_KEY=change-me-to-another-long-random-string

# MongoDB (leave empty to use in-memory Mongo for local demo)
MONGO_URI=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=oauth_hub

# OAuth callback base (server receives provider redirects here)
OAUTH_CALLBACK_BASE=http://localhost:8999/v1/oauth

# ---------- Providers (leave blank to disable) ----------

# GitHub https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Weibo https://open.weibo.com/
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=

# WeChat Open Platform website app https://open.weixin.qq.com/
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Google / Gmail https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Facebook) https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=

# Instagram (Meta Instagram Login) https://developers.facebook.com/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Douyin 抖音开放平台 https://developer.open-douyin.com/
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# Bilibili https://openhome.bilibili.com/
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=

# Kuaishou 快手开放平台 https://open.kuaishou.com/
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=

# Xiaohongshu 小红书开放平台 (enterprise access required)
XHS_APP_KEY=
XHS_APP_SECRET=

# QQ 互联 https://connect.qq.com/
QQ_APP_ID=
QQ_APP_KEY=

# 飞书 https://open.feishu.cn/
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 钉钉 https://open.dingtalk.com/
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 企业微信 https://work.weixin.qq.com/
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# X (Twitter) https://developer.x.com/
X_CLIENT_ID=
X_CLIENT_SECRET=

# Telegram Login Widget https://core.telegram.org/widgets/login
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# WhatsApp Cloud API OTP https://developers.facebook.com/docs/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Set to 1 to actually send WhatsApp messages in non-production
WHATSAPP_SEND_REAL=0
